@model List<WebUI.Dtos.UserDtos.UserWithRolesDto>

@{
    ViewData["Title"] = "Kullanıcı ve Rol Yönetimi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
    var allRoles = ViewBag.AllRoles as List<WebUI.Dtos.UserDtos.ResultOperationClaimDto> ?? new List<WebUI.Dtos.UserDtos.ResultOperationClaimDto>();
    int toplamKullanici = Model?.Count ?? 0;
    int adminSayisi = Model?.Count(u => u.IsAdmin) ?? 0;
    int projeYoneticisiSayisi = Model?.Count(u => u.IsProjeYoneticisi || u.HasProjeYonetimiAccess) ?? 0;
    int stajyerSayisi = Model?.Count(u => u.IsStajyer) ?? 0;
}

<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-users-cog mr-2 text-primary"></i>Kullanıcı ve Özel Rol Yönetimi</h1>
        <small class="text-muted">Kullanıcılara sol menü modülleriyle (Staj Başvuruları, Yeni Başvuru, Proje Yönetimi, Öğrenci Mesajları vb.) birebir eşleşen özel erişim izinleri atayın.</small>
    </div>
    <div>
        <button type="button" class="btn btn-sm btn-primary shadow-sm" data-toggle="modal" data-target="#modalYeniKullanici">
            <i class="fas fa-user-plus fa-sm text-white-50 mr-1"></i> Yeni Kullanıcı Ekle
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle mr-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<!-- İstatistik Kartları -->
<div class="row">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Toplam Kullanıcı</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@toplamKullanici</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-users fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-danger shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Sistem Yöneticileri (Admin)</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@adminSayisi</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-user-shield fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Proje / Görev Yetkilileri</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@projeYoneticisiSayisi</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-user-tie fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Stajyer Hesapları</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@stajyerSayisi</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-user-graduate fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Kullanıcılar Tablosu -->
<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-user-lock mr-2"></i>Kayıtlı Kullanıcılar ve Erişim Yetkileri</h6>
        <span class="badge badge-primary badge-pill font-weight-normal px-2 py-1">@toplamKullanici Kullanıcı</span>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th style="width: 35px;" class="text-center">#</th>
                        <th>Kullanıcı Bilgileri</th>
                        <th>Profil / Bağlantı</th>
                        <th>Erişim Yetkileri & Modüller</th>
                        <th style="width: 90px;" class="text-center">Durum</th>
                        <th style="width: 170px;" class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            count++;
                            string roleIdsJson = System.Text.Json.JsonSerializer.Serialize((user.Roles ?? new List<WebUI.Dtos.UserDtos.UserRoleItemDto>()).Select(r => r.OperationClaimId).ToList());
                            <tr>
                                <td class="text-center font-weight-bold align-middle">@count</td>
                                <td class="align-middle">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mr-2 shadow-sm font-weight-bold" style="width: 36px; height: 36px; font-size: 13px;">
                                            @((user.FirstName.Length > 0 ? user.FirstName[0].ToString().ToUpper() : "") + (user.LastName.Length > 0 ? user.LastName[0].ToString().ToUpper() : ""))
                                        </div>
                                        <div>
                                            <div class="font-weight-bold text-gray-900">@user.FullName</div>
                                            <small class="text-muted"><i class="fas fa-envelope mr-1"></i>@user.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="align-middle small">
                                    @if (user.StajBasvuruId.HasValue)
                                    {
                                        <div><span class="badge badge-light border text-primary"><i class="fas fa-university mr-1"></i>@user.Okul</span></div>
                                        <div class="text-muted mt-1">@user.Bolum @(!string.IsNullOrEmpty(user.StajKonusu) ? $"({user.StajKonusu})" : "")</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted"><i class="fas fa-briefcase mr-1"></i>Sistem Personeli / Yetkili</span>
                                    }
                                </td>
                                <td class="align-middle">
                                    @if (user.Roles != null && user.Roles.Any())
                                    {
                                        var visibleRoles = user.Roles.Where(r => !r.IsTechnicalClaim).ToList();
                                        if (visibleRoles.Any())
                                        {
                                            foreach (var role in visibleRoles)
                                            {
                                                <span class="badge @role.BadgeClass px-2 py-1 mr-1 mb-1 font-weight-bold shadow-sm">
                                                    <i class="fas fa-shield-alt mr-1"></i>@role.DisplayName
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge badge-light border text-muted">Erişim Yetkisi Yok</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge badge-light border text-muted">Erişim Yetkisi Yok</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    @if (user.Status)
                                    {
                                        <span class="badge badge-success px-2 py-1"><i class="fas fa-check-circle mr-1"></i>Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary px-2 py-1"><i class="fas fa-ban mr-1"></i>Pasif</span>
                                    }
                                </td>
                                <td class="text-center align-middle">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-primary btn-sm btn-manage-roles shadow-sm"
                                                data-id="@user.Id"
                                                data-name="@user.FullName"
                                                data-email="@user.Email"
                                                data-roles='@roleIdsJson'
                                                title="Modüler Erişim Yetkilerini Belirle">
                                            <i class="fas fa-user-tag mr-1"></i>Yetkilendir
                                        </button>
                                        <form asp-action="ToggleStatus" asp-controller="AdminKullaniciRol" asp-area="Admin" method="post" class="d-inline" onsubmit="return confirm('Kullanıcı durumunu değiştirmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="btn btn-outline-secondary btn-sm" title="@(user.Status ? "Pasife Al" : "Aktif Et")">
                                                <i class="fas @(user.Status ? "fa-toggle-on text-success" : "fa-toggle-off text-muted")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="fas fa-users-slash fa-3x mb-3 d-block text-gray-300"></i>
                                Sistemde henüz kayıtlı kullanıcı bulunmuyor.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal 1: Rolleri & Modüler Yetkileri Yönet -->
<div class="modal fade" id="modalRolleriYonet" tabindex="-1" role="dialog" aria-labelledby="modalRolleriYonetLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form asp-action="SetRoles" asp-controller="AdminKullaniciRol" asp-area="Admin" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="manageUserId" name="UserId" />
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title font-weight-bold" id="modalRolleriYonetLabel">
                        <i class="fas fa-user-shield mr-2"></i>Özel Yetkilendirme ve Menü Erişim Yönetimi
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <!-- Kullanıcı Bilgisi -->
                    <div class="card bg-light border-0 mb-3 shadow-sm">
                        <div class="card-body py-2 px-3 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted mr-1">Kullanıcı:</span>
                                <strong id="manageUserName" class="text-dark font-weight-bold"></strong>
                            </div>
                            <div>
                                <span class="text-muted mr-1">E-Posta:</span>
                                <span id="manageUserEmail" class="text-primary font-weight-bold"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Hızlı Şablon Seçim Butonları -->
                    <div class="mb-3">
                        <label class="font-weight-bold text-gray-800 d-block mb-2">
                            <i class="fas fa-bolt text-warning mr-1"></i>Hızlı Rol Şablonları (Tek Tıkla Seç):
                        </label>
                        <div class="btn-group btn-group-sm flex-wrap" role="group">
                            <button type="button" class="btn btn-outline-success mr-1 mb-1 btn-template shadow-sm" data-template="only-messages">
                                <i class="fas fa-comments mr-1"></i>Sadece Öğrenci Mesajları
                            </button>
                            <button type="button" class="btn btn-outline-primary mr-1 mb-1 btn-template shadow-sm" data-template="staj-sorumlusu">
                                <i class="fas fa-clipboard-list mr-1"></i>Staj Başvuru İşlemleri
                            </button>
                            <button type="button" class="btn btn-outline-info mr-1 mb-1 btn-template shadow-sm" data-template="proje-yoneticisi">
                                <i class="fas fa-project-diagram mr-1"></i>Proje ve Görev Yöneticisi
                            </button>
                            <button type="button" class="btn btn-outline-danger mr-1 mb-1 btn-template shadow-sm" data-template="super-admin">
                                <i class="fas fa-user-shield mr-1"></i>Süper Admin (Tüm Yetkiler)
                            </button>
                            <button type="button" class="btn btn-outline-secondary mb-1 btn-template shadow-sm" data-template="clear">
                                <i class="fas fa-times-circle mr-1"></i>Temizle
                            </button>
                        </div>
                    </div>

                    <hr class="my-3">

                    <!-- Modüler Yetkiler (Sidebar ile Birebir Uyumlu) -->
                    <label class="font-weight-bold text-gray-800 mb-2">
                        <i class="fas fa-th-list text-primary mr-1"></i>Sidebar Menülerine Göre Modüler Yetkileri Seçiniz:
                    </label>

                    <div class="row">
                        <!-- 1. STAJ BAŞVURU İŞLEMLERİ -->
                        <div class="col-md-6 mb-3">
                            <div class="card h-100 border-left-primary shadow-sm">
                                <div class="card-header py-2 bg-light font-weight-bold text-primary small text-uppercase">
                                    <i class="fas fa-clipboard-list mr-1"></i>Staj Başvuru İşlemleri
                                </div>
                                <div class="card-body p-3">
                                    @{
                                        var stajBasvuruClaim = allRoles.FirstOrDefault(r => r.Name.Equals("Staj.Basvurular", StringComparison.OrdinalIgnoreCase));
                                        var stajYeniClaim = allRoles.FirstOrDefault(r => r.Name.Equals("Staj.YeniBasvuru", StringComparison.OrdinalIgnoreCase));
                                    }
                                    @if (stajBasvuruClaim != null)
                                    {
                                        <div class="custom-control custom-checkbox mb-2">
                                            <input type="checkbox" class="custom-control-input role-checkbox claim-staj-basvuru" id="role_@stajBasvuruClaim.Id" name="OperationClaimIds" value="@stajBasvuruClaim.Id" data-name="@stajBasvuruClaim.Name" />
                                            <label class="custom-control-label font-weight-bold text-dark" for="role_@stajBasvuruClaim.Id">
                                                <i class="fas fa-clipboard-list text-primary mr-1"></i>Staj Başvuruları
                                            </label>
                                            <small class="text-muted d-block pl-4">Başvuru listesini görme, onaylama, reddetme ve detay inceleme.</small>
                                        </div>
                                    }
                                    @if (stajYeniClaim != null)
                                    {
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input role-checkbox claim-staj-yeni" id="role_@stajYeniClaim.Id" name="OperationClaimIds" value="@stajYeniClaim.Id" data-name="@stajYeniClaim.Name" />
                                            <label class="custom-control-label font-weight-bold text-dark" for="role_@stajYeniClaim.Id">
                                                <i class="fas fa-plus-circle text-info mr-1"></i>Yeni Başvuru Yap
                                            </label>
                                            <small class="text-muted d-block pl-4">Yönetici adına sisteme yeni staj başvurusu kaydetme formu.</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- 2. PROJE VE GÖREV İŞLEMLERİ -->
                        <div class="col-md-6 mb-3">
                            <div class="card h-100 border-left-info shadow-sm">
                                <div class="card-header py-2 bg-light font-weight-bold text-info small text-uppercase">
                                    <i class="fas fa-project-diagram mr-1"></i>Proje ve Görev İşlemleri
                                </div>
                                <div class="card-body p-3">
                                    @{
                                        var projeYonetimiClaim = allRoles.FirstOrDefault(r => r.Name.Equals("Proje.Yonetimi", StringComparison.OrdinalIgnoreCase));
                                        var projeTakipClaim = allRoles.FirstOrDefault(r => r.Name.Equals("Proje.TakipNotlandirma", StringComparison.OrdinalIgnoreCase));
                                    }
                                    @if (projeYonetimiClaim != null)
                                    {
                                        <div class="custom-control custom-checkbox mb-2">
                                            <input type="checkbox" class="custom-control-input role-checkbox claim-proje-yonetimi" id="role_@projeYonetimiClaim.Id" name="OperationClaimIds" value="@projeYonetimiClaim.Id" data-name="@projeYonetimiClaim.Name" />
                                            <label class="custom-control-label font-weight-bold text-dark" for="role_@projeYonetimiClaim.Id">
                                                <i class="fas fa-project-diagram text-info mr-1"></i>Proje Yönetimi
                                            </label>
                                            <small class="text-muted d-block pl-4">Proje tanımlama, görev açma, düzenleme ve silme.</small>
                                        </div>
                                    }
                                    @if (projeTakipClaim != null)
                                    {
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input role-checkbox claim-proje-takip" id="role_@projeTakipClaim.Id" name="OperationClaimIds" value="@projeTakipClaim.Id" data-name="@projeTakipClaim.Name" />
                                            <label class="custom-control-label font-weight-bold text-dark" for="role_@projeTakipClaim.Id">
                                                <i class="fas fa-award text-warning mr-1"></i>Proje Takip & Notlandırma
                                            </label>
                                            <small class="text-muted d-block pl-4">Stajyerlere proje görevlendirme ve proje notu/değerlendirmesi girme.</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- 3. İLETİŞİM -->
                        <div class="col-md-6 mb-3">
                            <div class="card h-100 border-left-success shadow-sm">
                                <div class="card-header py-2 bg-light font-weight-bold text-success small text-uppercase">
                                    <i class="fas fa-comments mr-1"></i>İletişim Modülü
                                </div>
                                <div class="card-body p-3">
                                    @{
                                        var mesajClaim = allRoles.FirstOrDefault(r => r.Name.Equals("Iletisim.OgrenciMesajlari", StringComparison.OrdinalIgnoreCase));
                                    }
                                    @if (mesajClaim != null)
                                    {
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input role-checkbox claim-mesaj" id="role_@mesajClaim.Id" name="OperationClaimIds" value="@mesajClaim.Id" data-name="@mesajClaim.Name" />
                                            <label class="custom-control-label font-weight-bold text-dark" for="role_@mesajClaim.Id">
                                                <i class="fas fa-comments text-success mr-1"></i>Öğrenci Mesajları
                                            </label>
                                            <small class="text-muted d-block pl-4">Kabul edilen stajyerlerle çift taraflı mesajlaşma ve sohbet.</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- 4. SİSTEM & YETKİLENDİRME -->
                        <div class="col-md-6 mb-3">
                            <div class="card h-100 border-left-danger shadow-sm">
                                <div class="card-header py-2 bg-light font-weight-bold text-danger small text-uppercase">
                                    <i class="fas fa-user-shield mr-1"></i>Sistem Yönetimi
                                </div>
                                <div class="card-body p-3">
                                    @{
                                        var adminClaim = allRoles.FirstOrDefault(r => r.Name.Equals("Admin", StringComparison.OrdinalIgnoreCase));
                                    }
                                    @if (adminClaim != null)
                                    {
                                        <div class="custom-control custom-checkbox">
                                            <input type="checkbox" class="custom-control-input role-checkbox claim-admin" id="role_@adminClaim.Id" name="OperationClaimIds" value="@adminClaim.Id" data-name="@adminClaim.Name" />
                                            <label class="custom-control-label font-weight-bold text-dark" for="role_@adminClaim.Id">
                                                <i class="fas fa-user-shield text-danger mr-1"></i>Süper Admin (Tam Erişim)
                                            </label>
                                            <small class="text-muted d-block pl-4">Kullanıcı & rol atama dahil tüm sistem modüllerine sınırsız yetki.</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-secondary py-2 px-3 small mt-3 mb-0">
                        <i class="fas fa-info-circle mr-1 text-primary"></i>
                        Kullanıcı oturum açtığında sadece burada işaretlenen modülleri sol menüde görür ve erişebilir.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary font-weight-bold">
                        <i class="fas fa-save mr-1"></i> Yetkileri Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 2: Yeni Kullanıcı Ekle -->
<div class="modal fade" id="modalYeniKullanici" tabindex="-1" role="dialog" aria-labelledby="modalYeniKullaniciLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form asp-action="CreateUser" asp-controller="AdminKullaniciRol" asp-area="Admin" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title font-weight-bold" id="modalYeniKullaniciLabel">
                        <i class="fas fa-user-plus mr-2"></i>Yeni Yetkili Kullanıcı Tanımla
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info py-2 small">
                        <i class="fas fa-info-circle mr-1"></i>
                        Yeni bir yetkili kullanıcı oluşturabilir ve erişmesini istediğiniz menüleri seçerek hemen görevlendirebilirsiniz.
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-800">Ad <span class="text-danger">*</span></label>
                            <input type="text" name="FirstName" class="form-control" placeholder="Örn: Ahmet" required maxlength="50" />
                        </div>
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-800">Soyad <span class="text-danger">*</span></label>
                            <input type="text" name="LastName" class="form-control" placeholder="Örn: Yılmaz" required maxlength="50" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-800">E-Posta Adresi <span class="text-danger">*</span></label>
                            <input type="email" name="Email" class="form-control" placeholder="ahmet.yilmaz@sirket.com" required />
                        </div>
                        <div class="form-group col-md-6">
                            <label class="font-weight-bold text-gray-800">Giriş Şifresi <span class="text-danger">*</span></label>
                            <input type="text" name="Password" class="form-control" value="Staj2026*" required minlength="6" oninvalid="this.setCustomValidity('En az 6 karakter girilmelidir.')" oninput="this.setCustomValidity('')" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold text-gray-800 mb-2">Başlangıç Erişim Yetkileri:</label>
                        <div class="border rounded p-3 bg-light" style="max-height: 240px; overflow-y: auto;">
                            @if (allRoles != null && allRoles.Any())
                            {
                                foreach (var role in allRoles.Where(r => r.IsModularMenuClaim))
                                {
                                    <div class="custom-control custom-checkbox mb-2">
                                        <input type="checkbox" class="custom-control-input" id="new_role_@role.Id" name="OperationClaimIds" value="@role.Id" />
                                        <label class="custom-control-label d-flex align-items-center justify-content-between" for="new_role_@role.Id">
                                            <span>
                                                <i class="@role.Icon mr-1 text-primary"></i>
                                                <strong class="text-dark">@role.DisplayName</strong>
                                                <small class="text-muted d-block">@role.Description</small>
                                            </span>
                                            <span class="badge @role.BadgeClass ml-2">@role.Category</span>
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-primary font-weight-bold">
                        <i class="fas fa-save mr-1"></i> Kullanıcıyı Oluştur & Yetkilendir
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Yetkilendir modalini açma
            $('.btn-manage-roles').click(function () {
                var btn = $(this);
                var userId = btn.data('id');
                var name = btn.data('name');
                var email = btn.data('email');
                var roleIds = btn.data('roles') || [];

                $('#manageUserId').val(userId);
                $('#manageUserName').text(name);
                $('#manageUserEmail').text(email);

                $('.role-checkbox').prop('checked', false);

                if (Array.isArray(roleIds)) {
                    roleIds.forEach(function (id) {
                        $('#role_' + id).prop('checked', true);
                    });
                }

                $('#modalRolleriYonet').modal('show');
            });

            // Hızlı Şablon Butonları
            $('.btn-template').click(function () {
                var template = $(this).data('template');
                var form = $(this).closest('form');

                // Önce tüm kutucukları temizle
                form.find('.role-checkbox').prop('checked', false);

                if (template === 'only-messages') {
                    // Sadece Öğrenci Mesajları
                    form.find('.claim-mesaj').prop('checked', true);
                } else if (template === 'staj-sorumlusu') {
                    // Staj Başvuru İşlemleri (Staj Başvuruları + Yeni Başvuru)
                    form.find('.claim-staj-basvuru').prop('checked', true);
                    form.find('.claim-staj-yeni').prop('checked', true);
                } else if (template === 'proje-yoneticisi') {
                    // Proje İşlemleri (Proje Yönetimi + Proje Takip)
                    form.find('.claim-proje-yonetimi').prop('checked', true);
                    form.find('.claim-proje-takip').prop('checked', true);
                } else if (template === 'super-admin') {
                    // Süper Admin (Tüm modüller)
                    form.find('.claim-admin').prop('checked', true);
                    form.find('.claim-staj-basvuru').prop('checked', true);
                    form.find('.claim-staj-yeni').prop('checked', true);
                    form.find('.claim-proje-yonetimi').prop('checked', true);
                    form.find('.claim-proje-takip').prop('checked', true);
                    form.find('.claim-mesaj').prop('checked', true);
                }
            });
        });
    </script>
}
