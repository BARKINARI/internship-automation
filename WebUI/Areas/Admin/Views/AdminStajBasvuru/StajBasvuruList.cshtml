@model List<ResultStajBasvuruDto>

@{
    ViewData["Title"] = "Staj Başvuruları";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-clipboard-list mr-2 text-primary"></i>Staj Başvuruları Yönetimi</h1>
    <a href="/Admin/AdminStajBasvuru/CreateStajBasvuru" class="d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm">
        <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Yeni Başvuru Oluştur
    </a>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle mr-2"></i><strong>Bağlantı Uyarısı:</strong> @ViewBag.ErrorMessage
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle mr-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<!-- DataTales Example -->
<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-table mr-1"></i>Gelen Başvuru Listesi</h6>
        <span class="badge badge-primary badge-pill">Toplam: @(Model?.Count ?? 0) Başvuru</span>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th style="width: 40px;">#</th>
                        <th>Adı Soyadı</th>
                        <th>Okul / Bölüm</th>
                        <th>İletişim</th>
                        <th>Staj Bilgileri</th>
                        <th style="width: 110px;" class="text-center">Özgeçmiş (CV)</th>
                        <th>Durum</th>
                        <th style="width: 170px;" class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model ?? new List<ResultStajBasvuruDto>())
                    {
                        count++;
                        string cvUrl = item.CvDosyaYolu ?? "";
                        if (!string.IsNullOrEmpty(cvUrl) && !cvUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                        {
                            cvUrl = $"https://localhost:7125{cvUrl}";
                        }

                        <tr>
                            <td class="text-center font-weight-bold">@count</td>
                            <td>
                                <strong>@item.Ad @item.Soyad</strong>
                                <small class="d-block text-muted">Sınıf: @item.Sinif</small>
                            </td>
                            <td>
                                <div>@item.Okul</div>
                                <small class="text-muted">@item.Bolum</small>
                            </td>
                            <td>
                                <div><i class="fas fa-envelope mr-1 text-secondary"></i><small>@item.Eposta</small></div>
                                <div><i class="fas fa-phone mr-1 text-secondary"></i><small>@item.Telefon</small></div>
                            </td>
                            <td>
                                <small class="d-block"><strong>Başlangıç:</strong> @item.StajBaslangicTarihi.ToString("dd.MM.yyyy")</small>
                                <small class="d-block"><strong>Bitiş:</strong> @item.StajBitisTarihi.ToString("dd.MM.yyyy")</small>
                                @if (!string.IsNullOrEmpty(item.StajKonusu))
                                {
                                    <small class="badge badge-secondary mt-1">@item.StajKonusu</small>
                                }
                            </td>
                            <td class="text-center align-middle">
                                @if (!string.IsNullOrEmpty(cvUrl))
                                {
                                    <a href="@cvUrl" target="_blank" class="btn btn-sm btn-info shadow-sm" title="CV İncele (Yeni Sekme)">
                                        <i class="fas fa-file-pdf mr-1"></i> CV İncele
                                    </a>
                                }
                                else
                                {
                                    <span class="badge badge-light text-muted border px-2 py-1">CV Yok</span>
                                }
                            </td>
                            <td class="text-center align-middle">
                                @if (item.StajBasvuruDurumu == 1)
                                {
                                    <span class="badge badge-warning text-dark px-2 py-1"><i class="fas fa-clock mr-1"></i>Beklemede</span>
                                }
                                else if (item.StajBasvuruDurumu == 2)
                                {
                                    <span class="badge badge-success px-2 py-1"><i class="fas fa-check-circle mr-1"></i>Kabul Edildi</span>
                                }
                                else if (item.StajBasvuruDurumu == 3)
                                {
                                    <span class="badge badge-danger px-2 py-1"><i class="fas fa-times-circle mr-1"></i>Reddedildi</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary px-2 py-1">Bilinmiyor</span>
                                }
                            </td>
                            <td class="text-center align-middle">
                                <div class="btn-group" role="group">
                                    @if (item.StajBasvuruDurumu == 2)
                                    {
                                        <a href="/Admin/AdminMesaj?stajBasvuruId=@item.Id" 
                                           class="btn btn-sm btn-outline-primary" 
                                           title="Öğrenci ile Mesajlaş">
                                            <i class="fas fa-comment-dots"></i>
                                        </a>
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-warning" 
                                                data-toggle="modal" 
                                                data-target="#approveModal-@item.Id" 
                                                title="Şifre Güncelle & Tekrar Mail Gönder">
                                            <i class="fas fa-key"></i>
                                        </button>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-info" data-toggle="modal" data-target="#detailModal-@item.Id" title="Detay">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    @if (item.StajBasvuruDurumu != 2)
                                    {
                                        <button type="button" 
                                                class="btn btn-sm btn-outline-success" 
                                                data-toggle="modal" 
                                                data-target="#approveModal-@item.Id" 
                                                title="Onayla ve Şifre Ata">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    }
                                    <a href="/Admin/AdminStajBasvuru/ChangeStatus?id=@item.Id&status=3" 
                                       class="btn btn-sm btn-outline-warning" 
                                       title="Reddet"
                                       onclick="return confirm('Bu staj başvurusunu reddetmek istiyor musunuz?');">
                                        <i class="fas fa-ban"></i>
                                    </a>
                                    <a href="/Admin/AdminStajBasvuru/DeleteStajBasvuru?id=@item.Id" 
                                       class="btn btn-sm btn-outline-danger" 
                                       title="Sil"
                                       onclick="return confirm('Bu başvuruyu silmek istediğinize emin misiniz?');">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>

                                <!-- Staj Onaylama & Şifre Gönderme Modalı -->
                                <div class="modal fade text-left" id="approveModal-@item.Id" tabindex="-1" role="dialog" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered" role="document">
                                        <div class="modal-content border-0 shadow-lg">
                                            <div class="modal-header bg-success text-white">
                                                <h5 class="modal-title font-weight-bold">
                                                    <i class="fas fa-user-check mr-2"></i>@(item.StajBasvuruDurumu == 2 ? "Şifre Güncelle & Tekrar Mail Gönder" : "Stajı Onayla & Şifre Ata")
                                                </h5>
                                                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Kapat">
                                                    <span aria-hidden="true">&times;</span>
                                                </button>
                                            </div>
                                            <form method="post" action="/Admin/AdminStajBasvuru/ApproveAndSendPassword">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <div class="modal-body p-4">
                                                    <div class="alert alert-info py-2 px-3 small mb-3">
                                                        <i class="fas fa-info-circle mr-1"></i> Başvuru onaylandığında öğrenci için bir kullanıcı hesabı oluşturulacak ve giriş şifresi e-posta adresine gönderilecektir.
                                                    </div>
                                                    <div class="form-group mb-2">
                                                        <label class="font-weight-bold text-gray-800 small">Öğrenci:</label>
                                                        <p class="mb-0 text-gray-900 font-weight-bold">@item.Ad @item.Soyad</p>
                                                    </div>
                                                    <div class="form-group mb-3">
                                                        <label class="font-weight-bold text-gray-800 small">E-Posta (Giriş Kullanıcı Adı):</label>
                                                        <p class="mb-0 text-muted font-weight-bold">@item.Eposta</p>
                                                    </div>
                                                    <div class="form-group mb-0">
                                                        <label class="font-weight-bold text-gray-800 small">Öğrenciye Atanacak Şifre <span class="text-danger">*</span></label>
                                                        <input type="text" name="password" class="form-control font-weight-bold text-primary" value="Staj2026*" required minlength="6" oninvalid="this.setCustomValidity('En az 6 karakter girilmelidir.')" oninput="this.setCustomValidity('')" placeholder="En az 6 karakter giriniz" />
                                                        <small class="form-text text-muted">Öğrenci sisteme (/Login/Index) bu şifre ile giriş yapacaktır. Dilerseniz şifreyi değiştirebilirsiniz.</small>
                                                    </div>
                                                </div>
                                                <div class="modal-footer bg-light">
                                                    <button type="button" class="btn btn-secondary" data-dismiss="modal">İptal</button>
                                                    <button type="submit" class="btn btn-success font-weight-bold shadow-sm">
                                                        <i class="fas fa-paper-plane mr-1"></i> Onayla ve Şifreyi Mail At
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <!-- Başvuru Detay Modalı -->
                                <div class="modal fade text-left" id="detailModal-@item.Id" tabindex="-1" role="dialog" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
                                        <div class="modal-content border-0 shadow-lg">
                                            <div class="modal-header bg-primary text-white">
                                                <h5 class="modal-title font-weight-bold">
                                                    <i class="fas fa-user-graduate mr-2"></i>@item.Ad @item.Soyad - Başvuru Detayı
                                                </h5>
                                                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                                                    <span aria-hidden="true">&times;</span>
                                                </button>
                                            </div>
                                            <div class="modal-body p-4">
                                                <div class="row">
                                                    <div class="col-md-6 mb-3">
                                                        <h6 class="font-weight-bold text-gray-800 border-bottom pb-2">
                                                            <i class="fas fa-user text-primary mr-2"></i>Kişisel ve İletişim Bilgileri
                                                        </h6>
                                                        <p class="mb-1"><strong>Ad Soyad:</strong> @item.Ad @item.Soyad</p>
                                                        <p class="mb-1"><strong>E-Posta:</strong> <a href="mailto:@item.Eposta">@item.Eposta</a></p>
                                                        <p class="mb-1"><strong>Telefon:</strong> <a href="tel:@item.Telefon">@item.Telefon</a></p>
                                                        <p class="mb-1"><strong>Referans:</strong> @(string.IsNullOrEmpty(item.Referans) ? "Belirtilmedi" : item.Referans)</p>
                                                    </div>
                                                    <div class="col-md-6 mb-3">
                                                        <h6 class="font-weight-bold text-gray-800 border-bottom pb-2">
                                                            <i class="fas fa-university text-primary mr-2"></i>Eğitim ve Staj Bilgileri
                                                        </h6>
                                                        <p class="mb-1"><strong>Üniversite / Okul:</strong> @item.Okul</p>
                                                        <p class="mb-1"><strong>Bölüm:</strong> @item.Bolum</p>
                                                        <p class="mb-1"><strong>Sınıf:</strong> @item.Sinif</p>
                                                        <p class="mb-1"><strong>Staj Alanı:</strong> @(string.IsNullOrEmpty(item.StajKonusu) ? "Belirtilmedi" : item.StajKonusu)</p>
                                                        <p class="mb-1"><strong>Tarihler:</strong> @item.StajBaslangicTarihi.ToString("dd.MM.yyyy") - @item.StajBitisTarihi.ToString("dd.MM.yyyy")</p>
                                                    </div>
                                                    <div class="col-12 mt-2">
                                                        <h6 class="font-weight-bold text-gray-800 border-bottom pb-2">
                                                            <i class="fas fa-comment-alt text-primary mr-2"></i>Kendini Tanıtma / Ön Yazı
                                                        </h6>
                                                        <div class="bg-light p-3 rounded border">
                                                            <p class="mb-0 text-gray-700 font-italic" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(item.KendiniTanitmaYazisi) ? "Aday bir ön yazı belirtmedi." : item.KendiniTanitmaYazisi)</p>
                                                        </div>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(cvUrl))
                                                    {
                                                        <div class="col-12 mt-3 text-right">
                                                            <a href="@cvUrl" target="_blank" class="btn btn-info shadow-sm">
                                                                <i class="fas fa-file-pdf mr-1"></i> CV Belgesini Yeni Sekmede Aç
                                                            </a>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dataTable').DataTable({
                "language": {
                    "emptyTable": "Kayıtlı staj başvurusu bulunamadı",
                    "info": "_TOTAL_ başvurudan _START_ - _END_ arası gösteriliyor",
                    "infoEmpty": "Kayıt yok",
                    "infoFiltered": "(_MAX_ başvuru arasından filtrelendi)",
                    "lengthMenu": "Sayfada _MENU_ başvuru göster",
                    "loadingRecords": "Yükleniyor...",
                    "processing": "İşleniyor...",
                    "search": "Ara:",
                    "zeroRecords": "Eşleşen başvuru bulunamadı",
                    "paginate": {
                        "first": "İlk",
                        "last": "Son",
                        "next": "Sonraki",
                        "previous": "Önceki"
                    }
                }
            });
        });
    </script>
}