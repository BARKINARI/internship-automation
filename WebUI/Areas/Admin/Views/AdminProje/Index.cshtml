@model WebUI.Dtos.ProjeDtos.AdminProjeViewModel

@{
    ViewData["Title"] = "Proje Yönetimi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
    int toplamProje = Model.Projeler?.Count ?? 0;
    int devamEden = Model.Projeler?.Count(p => p.Durum == 2) ?? 0;
    int tamamlanan = Model.Projeler?.Count(p => p.Durum == 3) ?? 0;
    int toplamAtama = Model.Projeler?.Sum(p => p.AtananStajyerSayisi) ?? 0;
}

<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-project-diagram mr-2 text-primary"></i>Proje ve Görev Yönetimi</h1>
        <small class="text-muted">Kabul edilen stajyerler için projeler tanımlayın, atayın ve teslim durumlarını takip edin.</small>
    </div>
    <div>
        <a href="/Admin/AdminProje/StajyerProjeleri" class="btn btn-sm btn-info shadow-sm mr-2">
            <i class="fas fa-tasks fa-sm text-white-50 mr-1"></i> Tüm Atamalar & Notlar
        </a>
        <button type="button" class="btn btn-sm btn-primary shadow-sm" data-toggle="modal" data-target="#modalYeniProje">
            <i class="fas fa-plus fa-sm text-white-50 mr-1"></i> Yeni Proje Ekle
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle mr-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<!-- İstatistik Kartları -->
<div class="row">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Toplam Proje</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@toplamProje</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-folder-open fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Devam Eden Projeler</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@devamEden</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-spinner fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Tamamlanan Projeler</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@tamamlanan</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-check-double fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-warning shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Toplam Stajyer Ataması</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@toplamAtama</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-user-tag fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Projeler Tablosu -->
<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-tasks mr-2"></i>Tanımlı Projeler Listesi</h6>
        <span class="badge badge-primary badge-pill font-weight-normal px-2 py-1">@toplamProje Proje</span>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" id="dataTable" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th style="width: 40px;" class="text-center">#</th>
                        <th>Proje Bilgileri</th>
                        <th style="width: 160px;">Tarih Aralığı</th>
                        <th style="width: 120px;" class="text-center">Durum</th>
                        <th style="width: 110px;" class="text-center">Atanan Stajyer</th>
                        <th style="width: 220px;" class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Projeler != null && Model.Projeler.Any())
                    {
                        foreach (var item in Model.Projeler)
                        {
                            count++;
                            <tr>
                                <td class="text-center font-weight-bold align-middle">@count</td>
                                <td class="align-middle">
                                    <div class="font-weight-bold text-gray-900" style="font-size: 15px;">
                                        <i class="fas fa-layer-group text-primary mr-1"></i>@item.Baslik
                                    </div>
                                    <small class="text-muted d-block mt-1">@item.Aciklama</small>
                                </td>
                                <td class="align-middle small">
                                    <div><i class="far fa-calendar-alt text-success mr-1"></i><strong>Başlangıç:</strong> @item.BaslangicTarihi.ToString("dd.MM.yyyy")</div>
                                    <div class="mt-1"><i class="far fa-calendar-check text-danger mr-1"></i><strong>Bitiş:</strong> @item.BitisTarihi.ToString("dd.MM.yyyy")</div>
                                </td>
                                <td class="text-center align-middle">
                                    <span class="badge @item.DurumRozet px-2 py-1 font-weight-bold">
                                        @item.DurumMetni
                                    </span>
                                </td>
                                <td class="text-center align-middle">
                                    <a href="/Admin/AdminProje/StajyerProjeleri?projeId=@item.Id" class="badge badge-secondary px-2 py-1" title="Atamaları Görüntüle">
                                        <i class="fas fa-users mr-1"></i>@item.AtananStajyerSayisi Kişi
                                    </a>
                                </td>
                                <td class="text-center align-middle">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button" class="btn btn-success btn-sm btn-assign" 
                                                data-id="@item.Id" 
                                                data-title="@item.Baslik" 
                                                title="Stajyere Proje Ata">
                                            <i class="fas fa-user-plus mr-1"></i>Ata
                                        </button>
                                        <button type="button" class="btn btn-outline-primary btn-sm btn-edit"
                                                data-id="@item.Id"
                                                data-baslik="@item.Baslik"
                                                data-aciklama="@item.Aciklama"
                                                data-baslangic="@item.BaslangicTarihi.ToString("yyyy-MM-dd")"
                                                data-bitis="@item.BitisTarihi.ToString("yyyy-MM-dd")"
                                                data-durum="@item.Durum"
                                                title="Projeyi Düzenle">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <form asp-action="Delete" asp-controller="AdminProje" asp-area="Admin" method="post" class="d-inline" onsubmit="return confirm('Bu projeyi silmek istediğinize emin misiniz? (Atanan stajyer ilişkileri etkilenebilir)');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Projeyi Sil">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="fas fa-folder-open fa-3x mb-3 d-block text-gray-300"></i>
                                Henüz tanımlanmış bir proje bulunmamaktadır. Sağ üstteki <strong>"Yeni Proje Ekle"</strong> butonundan başlayabilirsiniz.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal 1: Yeni Proje Ekle -->
<div class="modal fade" id="modalYeniProje" tabindex="-1" role="dialog" aria-labelledby="modalYeniProjeLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form asp-action="Create" asp-controller="AdminProje" asp-area="Admin" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title font-weight-bold" id="modalYeniProjeLabel">
                        <i class="fas fa-plus-circle mr-2"></i>Yeni Proje / Görev Tanımla
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="font-weight-bold text-gray-800">Proje Başlığı <span class="text-danger">*</span></label>
                        <input type="text" name="Baslik" class="form-control" placeholder="Örn: E-Ticaret Sepet Modülü Geliştirme" required maxlength="200" />
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold text-gray-800">Proje Açıklaması & Yönergeler <span class="text-danger">*</span></label>
                        <textarea name="Aciklama" class="form-control" rows="4" placeholder="Stajyerden istenen görev detayları, kullanılacak teknolojiler ve teslim kriterleri..." required></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold text-gray-800">Başlangıç Tarihi <span class="text-danger">*</span></label>
                                <input type="date" name="BaslangicTarihi" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold text-gray-800">Bitiş / Teslim Tarihi <span class="text-danger">*</span></label>
                                <input type="date" name="BitisTarihi" class="form-control" value="@DateTime.Today.AddDays(14).ToString("yyyy-MM-dd")" required />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold text-gray-800">Proje Başlangıç Durumu</label>
                        <select name="Durum" class="form-control">
                            <option value="1" selected>Beklemede</option>
                            <option value="2">Devam Ediyor</option>
                            <option value="3">Tamamlandı</option>
                            <option value="4">İptal Edildi</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-primary font-weight-bold">
                        <i class="fas fa-save mr-1"></i> Projeyi Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 2: Proje Düzenle -->
<div class="modal fade" id="modalDuzenle" tabindex="-1" role="dialog" aria-labelledby="modalDuzenleLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form asp-action="Edit" asp-controller="AdminProje" asp-area="Admin" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editId" name="Id" />
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title font-weight-bold" id="modalDuzenleLabel">
                        <i class="fas fa-edit mr-2"></i>Projeyi Güncelle
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label class="font-weight-bold text-gray-800">Proje Başlığı <span class="text-danger">*</span></label>
                        <input type="text" id="editBaslik" name="Baslik" class="form-control" required maxlength="200" />
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold text-gray-800">Proje Açıklaması & Yönergeler <span class="text-danger">*</span></label>
                        <textarea id="editAciklama" name="Aciklama" class="form-control" rows="4" required></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold text-gray-800">Başlangıç Tarihi <span class="text-danger">*</span></label>
                                <input type="date" id="editBaslangic" name="BaslangicTarihi" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="font-weight-bold text-gray-800">Bitiş / Teslim Tarihi <span class="text-danger">*</span></label>
                                <input type="date" id="editBitis" name="BitisTarihi" class="form-control" required />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold text-gray-800">Proje Durumu</label>
                        <select id="editDurum" name="Durum" class="form-control">
                            <option value="1">Beklemede</option>
                            <option value="2">Devam Ediyor</option>
                            <option value="3">Tamamlandı</option>
                            <option value="4">İptal Edildi</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary font-weight-bold">
                        <i class="fas fa-check mr-1"></i> Değişiklikleri Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal 3: Stajyere Proje Ata -->
<div class="modal fade" id="modalStajyereAta" tabindex="-1" role="dialog" aria-labelledby="modalStajyereAtaLabel" aria-hidden="true">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <form asp-action="Assign" asp-controller="AdminProje" asp-area="Admin" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="assignProjeId" name="ProjeId" />
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title font-weight-bold" id="modalStajyereAtaLabel">
                        <i class="fas fa-user-plus mr-2"></i>Stajyere Proje Görevi Ata
                    </h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info py-2 small">
                        <i class="fas fa-info-circle mr-1"></i>
                        Proje atandığında öğrenciye sistemden otomatik bildirim mesajı iletilecektir.
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold text-gray-800">Seçilen Proje:</label>
                        <input type="text" id="assignProjeBaslik" class="form-control bg-light" readonly />
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold text-gray-800">Atanacak Stajyer (Kabul Edilenler) <span class="text-danger">*</span></label>
                        <select name="StajBasvuruId" class="form-control" required>
                            <option value="">-- Lütfen Stajyer Seçiniz --</option>
                            @if (Model.KabulEdilenOgrenciler != null && Model.KabulEdilenOgrenciler.Any())
                            {
                                foreach (var ogrenci in Model.KabulEdilenOgrenciler)
                                {
                                    <option value="@ogrenci.Id">@ogrenci.Ad @ogrenci.Soyad (@ogrenci.Okul - @ogrenci.StajKonusu)</option>
                                }
                            }
                            else
                            {
                                <option value="" disabled>Kabul edilmiş stajyer bulunmuyor.</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-success font-weight-bold">
                        <i class="fas fa-paper-plane mr-1"></i> Projeyi Ata & Bildir
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Edit modal data population
            $('.btn-edit').click(function () {
                var btn = $(this);
                $('#editId').val(btn.data('id'));
                $('#editBaslik').val(btn.data('baslik'));
                $('#editAciklama').val(btn.data('aciklama'));
                $('#editBaslangic').val(btn.data('baslangic'));
                $('#editBitis').val(btn.data('bitis'));
                $('#editDurum').val(btn.data('durum'));
                $('#modalDuzenle').modal('show');
            });

            // Assign modal data population
            $('.btn-assign').click(function () {
                var btn = $(this);
                $('#assignProjeId').val(btn.data('id'));
                $('#assignProjeBaslik').val(btn.data('title'));
                $('#modalStajyereAta').modal('show');
            });
        });
    </script>
}
