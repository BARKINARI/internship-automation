@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

    @await Component.InvokeAsync("_AdminLayoutHeadComponentPartial")

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        @await Component.InvokeAsync("_AdminLayoutSidebarComponentPartial")
        <!-- End of Sidebar -->

        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- Main Content -->
            <div id="content">

                <!-- Topbar -->
                @await Component.InvokeAsync("_AdminLayoutTopbarComponentPartial")
                <!-- End of Topbar -->

                <!-- Begin Page Content -->
                <div class="container-fluid">
                    @RenderBody()
                </div>
                <!-- /.container-fluid -->

            </div>
            <!-- End of Main Content -->

            <!-- Footer -->
            @await Component.InvokeAsync("_AdminLayoutFooterComponentPartial")
            <!-- End of Footer -->

        </div>
        <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Logout Modal-->
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold text-gray-800" id="logoutModalLabel">
                        <i class="fas fa-sign-out-alt mr-2 text-danger"></i>Oturumu Kapat
                    </h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Kapat">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">Mevcut oturumunuzu sonlandırmak istediğinizden emin misiniz?</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Vazgeç</button>
                    <a class="btn btn-danger font-weight-bold" href="/Login/LogOut">
                        <i class="fas fa-sign-out-alt mr-1"></i> Çıkış Yap
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    @await Component.InvokeAsync("_AdminLayoutScriptsComponentPartial")
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>