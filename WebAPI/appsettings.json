{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "StajSistemi": "Host=localhost;Port=5432;Database=StajSistemiDb;Username=postgres;Password=YOUR_DATABASE_PASSWORD;"
  },
  "CacheSettings": {
    "SlidingExpiration": 2
  },
  "TokenOptions": {
    "Audience": "ae@staj.com",
    "Issuer": "ae@staj.com",
    "AccessTokenExpiration": 60,
    "RefreshTokenTTL": 7,
    "SecurityKey": "supersecretkey_stajsistemi_supersecretkey_aestaj_12345678901234567890"
  },
  "MailSettings": {
    "Server": "smtp.gmail.com",
    "Port": 587,
    "SenderFullName": "AE Yazılım",
    "SenderEmail": "your-email@gmail.com",
    "UserName": "your-email@gmail.com",
    "Password": "YOUR_GMAIL_APP_PASSWORD",
    "AuthenticationRequired": true
  },
  "SeriLogConfigurations": {
    "FileLogConfiguration": {
      "FolderPath": "/logs/"
    },
    "PostgreConfiguration": {
      "ConnectionString": "Host=localhost;Port=5432;Database=StajSistemiDb;Username=postgres;Password=YOUR_DATABASE_PASSWORD;",
      "NeedAutoCreateTable": true,
      "TableName": "Logs"
    }
  },
  "WebAPIConfiguration": {
    "APIDomain": "https://localhost:7125/api",
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  }
}